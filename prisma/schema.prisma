generator client {
  provider     = "prisma-client"
  output       = "../packages/platform/database/generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ConsentStatus {
  GRANTED
  DENIED
  WITHDRAWN
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PlanType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DEFERRED
  CANCELLED
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  ACHIEVED
  ABANDONED
  ARCHIVED
}

enum FocusKind {
  DEEP_WORK
  POMODORO
  CUSTOM
}

enum FocusStatus {
  RUNNING
  PAUSED
  COMPLETED
  ABANDONED
}

enum HabitKind {
  BOOLEAN
  COUNT
  DURATION
  AVOIDANCE
}

enum TrackerKind {
  LEARNING_PATH
  LEARNING_ITEM
  PROGRAMMING_SKILL
  PROGRAMMING_PROJECT
  CODING_PROBLEM
  READING_ITEM
  QURAN_PLAN
  QURAN_REVIEW
  PRAYER
  WORKOUT_PLAN
  WORKOUT_EXERCISE
  SLEEP
  MOOD
  BODY_METRIC
  CUSTOM
}

enum EntrySource {
  MANUAL
  IMPORT
  INTEGRATION
  SYSTEM
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum ResourceKind {
  BOOKMARK
  ARTICLE
  BOOK
  COURSE
  VIDEO
  PODCAST
  NEWS
  FILE
  OTHER
}

enum AIRunKind {
  COACH
  MENTOR
  DAILY_REVIEW
  WEEKLY_REVIEW
  MONTHLY_REVIEW
  SUGGESTION
  SMART_REMINDER
  AGENT_RESEARCH
}

enum AIRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum AIProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum OccurrenceStatus {
  PENDING
  DEFERRED
  ENQUEUED
  DELIVERED
  COMPLETED
  MISSED
  CANCELLED
  FAILED
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  EXPIRED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  EXPIRED
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  CANCELLED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.Citext
  emailVerifiedAt   DateTime?  @db.Timestamptz(6)
  passwordHash      String?
  passwordChangedAt DateTime?  @db.Timestamptz(6)
  status            UserStatus @default(PENDING_VERIFICATION)
  permissionVersion Int        @default(1)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?  @db.Timestamptz(6)
  version           Int        @default(1)

  profile                UserProfile?
  oauthAccounts          OAuthAccount[]
  oauthTransactions      OAuthTransaction[]
  sessions               AuthSession[]
  refreshTokens          RefreshToken[]
  authTokens             AuthOneTimeToken[]
  roles                  UserRole[]
  consents               Consent[]
  preferences            UserPreference[]
  pushSubscriptions      PushSubscription[]
  goals                  Goal[]
  plans                  Plan[]
  timeBlocks             TimeBlock[]
  calendarConnections    CalendarConnection[]
  calendarEvents         CalendarEvent[]
  focusSessions          FocusSession[]
  habits                 Habit[]
  trackerItems           TrackerItem[]
  journalEntries         JournalEntry[]
  reflections            Reflection[]
  notes                  Note[]
  bookmarks              Bookmark[]
  resources              Resource[]
  lifeVisions            LifeVision[]
  scheduleProposals      ScheduleProposal[]
  aiConversations        AIConversation[]
  aiRuns                 AIRun[]
  aiContextGrants        AIContextGrant[]
  aiProposals            AIProposal[]
  reminders              Reminder[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  xpEntries              XPLedgerEntry[]
  achievementAwards      AchievementAward[]
  userLevel              UserLevel?
  streaks                Streak[]
  challengeEnrollments   ChallengeEnrollment[]
  metricEvents           MetricEvent[]
  metricSnapshots        DailyMetricSnapshot[]
  reportJobs             ReportJob[]
  exportJobs             ExportJob[]
  idempotencyRecords     IdempotencyRecord[]
  auditEvents            AuditEvent[]            @relation("AuditActor")
  outboxEvents           OutboxEvent[]

  @@index([status, createdAt])
  @@map("users")
}

model UserProfile {
  userId        String   @id @db.Uuid
  displayName   String   @db.VarChar(120)
  avatarAssetId String?  @db.VarChar(255)
  timeZone      String   @default("UTC") @db.VarChar(80)
  locale        String   @default("en") @db.VarChar(20)
  weekStartsOn  Int      @default(1) @db.SmallInt
  accessibility Json     @default("{}")
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  version       Int      @default(1)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OAuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  provider              String    @db.VarChar(50)
  providerSubject       String    @db.VarChar(255)
  providerEmail         String?   @db.Citext
  accessTokenEncrypted  Bytes?
  refreshTokenEncrypted Bytes?
  scope                 String?   @db.Text
  expiresAt             DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@map("oauth_accounts")
}

model OAuthTransaction {
  id                    String    @id @default(uuid()) @db.Uuid
  initiatedByUserId     String?   @db.Uuid
  provider              String    @db.VarChar(50)
  stateHash             String    @unique @db.Char(64)
  nonceHash             String?   @db.Char(64)
  nonceEncrypted        Bytes?
  codeVerifierEncrypted Bytes
  redirectUri           String    @db.VarChar(500)
  returnTo              String    @db.VarChar(500)
  locale                String    @db.VarChar(20)
  timeZone              String    @db.VarChar(80)
  expiresAt             DateTime  @db.Timestamptz(6)
  consumedAt            DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  initiatedBy           User?     @relation(fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@index([provider, expiresAt])
  @@index([initiatedByUserId, createdAt(sort: Desc)])
  @@map("oauth_transactions")
}

model AuthSession {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  status          SessionStatus  @default(ACTIVE)
  deviceName      String?        @db.VarChar(120)
  userAgentHash   String?        @db.VarChar(128)
  ipPrefix        String?        @db.VarChar(64)
  authMethod      String         @db.VarChar(40)
  authenticatedAt DateTime       @default(now()) @db.Timestamptz(6)
  mfaVerifiedAt   DateTime?      @db.Timestamptz(6)
  lastSeenAt      DateTime       @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime       @db.Timestamptz(6)
  revokedAt       DateTime?      @db.Timestamptz(6)
  revokeReason    String?        @db.VarChar(80)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthOneTimeToken {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  purpose           AuthTokenPurpose
  tokenHash         String           @unique @db.Char(64)
  requestedIpPrefix String?          @db.VarChar(64)
  expiresAt         DateTime         @db.Timestamptz(6)
  consumedAt        DateTime?        @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("auth_one_time_tokens")
}

model RefreshToken {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  sessionId    String         @db.Uuid
  familyId     String         @db.Uuid
  tokenHash    String         @unique @db.Char(64)
  parentId     String?        @db.Uuid
  replacedById String?        @unique @db.Uuid
  issuedAt     DateTime       @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime       @db.Timestamptz(6)
  usedAt       DateTime?      @db.Timestamptz(6)
  revokedAt    DateTime?      @db.Timestamptz(6)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent       RefreshToken?  @relation("TokenLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children     RefreshToken[] @relation("TokenLineage")
  replacement  RefreshToken?  @relation("TokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaced     RefreshToken?  @relation("TokenReplacement")

  @@index([sessionId, familyId])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(60)
  name        String           @db.VarChar(100)
  description String?          @db.Text
  system      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String           @db.Text
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  grantedById String?   @db.Uuid
  grantedAt   DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime? @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Consent {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  purpose       String        @db.VarChar(100)
  policyVersion String        @db.VarChar(40)
  status        ConsentStatus
  decidedAt     DateTime      @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime?     @db.Timestamptz(6)
  evidence      Json          @default("{}")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose, policyVersion])
  @@index([userId, purpose, status])
  @@map("consents")
}

model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  namespace String   @db.VarChar(80)
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  version   Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, namespace, key])
  @@map("user_preferences")
}

model PushSubscription {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  endpointHash      String    @unique @db.Char(64)
  endpointEncrypted Bytes
  p256dhEncrypted   Bytes
  authEncrypted     Bytes
  userAgent         String?   @db.VarChar(300)
  deviceName        String?   @db.VarChar(120)
  expiresAt         DateTime? @db.Timestamptz(6)
  revokedAt         DateTime? @db.Timestamptz(6)
  lastSuccessAt     DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("push_subscriptions")
}

model Goal {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  parentGoalId   String?        @db.Uuid
  title          String         @db.VarChar(200)
  description    String?        @db.Text
  status         GoalStatus     @default(DRAFT)
  horizon        String         @db.VarChar(30)
  successMeasure String?        @db.Text
  targetValue    Decimal?       @db.Decimal(18, 4)
  targetUnit     String?        @db.VarChar(40)
  targetDate     DateTime?      @db.Date
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?      @db.Timestamptz(6)
  version        Int            @default(1)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Goal?          @relation("GoalTree", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children       Goal[]         @relation("GoalTree")
  milestones     Milestone[]
  planItems      PlanItem[]
  focusSessions  FocusSession[]

  @@index([userId, status, targetDate])
  @@index([parentGoalId])
  @@map("goals")
}

model Milestone {
  id          String     @id @default(uuid()) @db.Uuid
  goalId      String     @db.Uuid
  title       String     @db.VarChar(200)
  dueDate     DateTime?  @db.Date
  status      ItemStatus @default(PLANNED)
  position    Int
  completedAt DateTime?  @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  version     Int        @default(1)
  goal        Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, position])
  @@index([goalId, status])
  @@map("milestones")
}

model LifeVision {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  revision   Int              @default(1)
  narrative  String?          @db.Text
  values     Json             @default("[]")
  antiGoals  Json             @default("[]")
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(6)
  archivedAt DateTime?        @db.Timestamptz(6)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  areas      LifeVisionArea[]

  @@unique([userId, revision])
  @@index([userId, archivedAt])
  @@map("life_visions")
}

model LifeVisionArea {
  id           String     @id @default(uuid()) @db.Uuid
  lifeVisionId String     @db.Uuid
  key          String     @db.VarChar(60)
  title        String     @db.VarChar(100)
  statement    String?    @db.Text
  position     Int
  lifeVision   LifeVision @relation(fields: [lifeVisionId], references: [id], onDelete: Cascade)

  @@unique([lifeVisionId, key])
  @@unique([lifeVisionId, position])
  @@map("life_vision_areas")
}

model Plan {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  type            PlanType
  periodStart     DateTime   @db.Date
  periodEnd       DateTime   @db.Date
  timeZone        String     @db.VarChar(80)
  title           String?    @db.VarChar(200)
  theme           String?    @db.VarChar(160)
  status          PlanStatus @default(DRAFT)
  capacityMinutes Int?
  notDoing        Json       @default("[]")
  closedAt        DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)
  version         Int        @default(1)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           PlanItem[]

  @@unique([userId, type, periodStart])
  @@index([userId, type, status, periodStart])
  @@map("plans")
}

model PlanItem {
  id                 String      @id @default(uuid()) @db.Uuid
  planId             String      @db.Uuid
  goalId             String?     @db.Uuid
  parentItemId       String?     @db.Uuid
  title              String      @db.VarChar(240)
  status             ItemStatus  @default(PLANNED)
  isPrimary          Boolean     @default(false)
  estimateMinutes    Int?
  position           Int
  completedAt        DateTime?   @db.Timestamptz(6)
  carryForwardFromId String?     @db.Uuid
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(6)
  version            Int         @default(1)
  plan               Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal               Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  parent             PlanItem?   @relation("PlanItemTree", fields: [parentItemId], references: [id], onDelete: SetNull)
  children           PlanItem[]  @relation("PlanItemTree")
  timeBlocks         TimeBlock[]

  @@unique([planId, position])
  @@index([goalId])
  @@index([planId, status])
  @@map("plan_items")
}

model TimeBlock {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  planItemId String?   @db.Uuid
  title      String    @db.VarChar(200)
  startsAt   DateTime  @db.Timestamptz(6)
  endsAt     DateTime  @db.Timestamptz(6)
  timeZone   String    @db.VarChar(80)
  locked     Boolean   @default(false)
  source     String    @default("FOCUSED") @db.VarChar(30)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  version    Int       @default(1)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planItem   PlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt, endsAt])
  @@index([planItemId])
  @@map("time_blocks")
}

model ScheduleProposal {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  inputVersion   String           @db.VarChar(100)
  status         AIProposalStatus @default(PENDING)
  constraints    Json
  proposedBlocks Json
  explanation    Json
  expiresAt      DateTime         @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  decidedAt      DateTime?        @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@map("schedule_proposals")
}

model CalendarConnection {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @db.Uuid
  provider              String          @db.VarChar(50)
  providerAccountId     String          @db.VarChar(255)
  accessTokenEncrypted  Bytes
  refreshTokenEncrypted Bytes?
  scopes                String[]
  syncCursorEncrypted   Bytes?
  status                String          @default("ACTIVE") @db.VarChar(30)
  lastSyncedAt          DateTime?       @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(6)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events                CalendarEvent[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId, status])
  @@map("calendar_connections")
}

model CalendarEvent {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  connectionId  String?             @db.Uuid
  externalId    String?             @db.VarChar(255)
  title         String              @db.VarChar(240)
  startsAt      DateTime            @db.Timestamptz(6)
  endsAt        DateTime            @db.Timestamptz(6)
  timeZone      String              @db.VarChar(80)
  busy          Boolean             @default(true)
  sourceVersion String?             @db.VarChar(120)
  deletedAt     DateTime?           @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    CalendarConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([userId, startsAt, endsAt])
  @@map("calendar_events")
}

model FocusSession {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  goalId         String?        @db.Uuid
  kind           FocusKind
  status         FocusStatus    @default(RUNNING)
  intent         String         @db.VarChar(300)
  plannedSeconds Int
  startedAt      DateTime       @db.Timestamptz(6)
  completedAt    DateTime?      @db.Timestamptz(6)
  abandonedAt    DateTime?      @db.Timestamptz(6)
  outcome        String?        @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  version        Int            @default(1)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  pauses         SessionPause[]
  interruptions  Interruption[]

  @@index([userId, startedAt(sort: Desc), id(sort: Desc)])
  @@index([userId, status])
  @@map("focus_sessions")
}

model SessionPause {
  id             String       @id @default(uuid()) @db.Uuid
  focusSessionId String       @db.Uuid
  startedAt      DateTime     @db.Timestamptz(6)
  endedAt        DateTime?    @db.Timestamptz(6)
  reason         String?      @db.VarChar(160)
  focusSession   FocusSession @relation(fields: [focusSessionId], references: [id], onDelete: Cascade)

  @@index([focusSessionId, startedAt])
  @@map("session_pauses")
}

model Interruption {
  id             String       @id @default(uuid()) @db.Uuid
  focusSessionId String       @db.Uuid
  occurredAt     DateTime     @default(now()) @db.Timestamptz(6)
  category       String       @db.VarChar(60)
  note           String?      @db.VarChar(500)
  resumed        Boolean?
