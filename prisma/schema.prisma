  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model WebhookInbox {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String    @db.VarChar(60)
  externalEventId String    @db.VarChar(255)
  payloadHash     String    @db.Char(64)
  receivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)
  status          String    @default("RECEIVED") @db.VarChar(30)
  failureCode     String?   @db.VarChar(100)

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@map("webhook_inbox")
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @db.Uuid
  aggregateType    String    @db.VarChar(80)
  aggregateId      String    @db.Uuid
  aggregateVersion Int
  eventType        String    @db.VarChar(120)
  eventVersion     Int       @default(1)
  payload          Json
  occurredAt       DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt      DateTime? @db.Timestamptz(6)
  publishAttempts  Int       @default(0)
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([aggregateType, aggregateId, aggregateVersion, eventType])
  @@index([publishedAt, occurredAt, id])
  @@index([userId, occurredAt])
  @@map("outbox_events")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @db.Uuid
  actorType     String   @db.VarChar(30)
  action        String   @db.VarChar(120)
  targetType    String?  @db.VarChar(80)
  targetId      String?  @db.Uuid
  reasonCode    String?  @db.VarChar(80)
  correlationId String   @db.VarChar(80)
  ipPrefix      String?  @db.VarChar(64)
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_events")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String   @db.Text
  enabled     Boolean  @default(false)
  rules       Json     @default("{}")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("feature_flags")
}
