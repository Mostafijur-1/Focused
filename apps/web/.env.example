NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Neon: pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://focused:focused@127.0.0.1:5432/focused?schema=public
DIRECT_URL=postgresql://focused:focused@127.0.0.1:5432/focused?schema=public
# Disposable database used only by pnpm db:drift:check; never use production here.
SHADOW_DATABASE_URL=postgresql://focused:focused@127.0.0.1:5432/focused_shadow?schema=public

# Ed25519 PKCS#8/SPKI PEM values encoded as base64. See docs/authentication.md for rotation.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_KEY_ID=focused-local-1
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=focused-api
# 32 random bytes encoded as base64; used for short-lived OAuth transaction secrets.
AUTH_DATA_ENCRYPTION_KEY_BASE64=

# Auth delivery and distributed rate limiting.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Focused <security@example.com>
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OAuth providers are enabled only when both values are configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
