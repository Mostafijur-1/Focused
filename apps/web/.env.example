NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Neon: pooled runtime URL and direct migration URL.
DATABASE_URL=postgresql://focused:focused@127.0.0.1:5432/focused?schema=public
DIRECT_URL=postgresql://focused:focused@127.0.0.1:5432/focused?schema=public
# Disposable database used only by pnpm db:drift:check; never use production here.
SHADOW_DATABASE_URL=postgresql://focused:focused@127.0.0.1:5432/focused_shadow?schema=public

# Ed25519 PKCS#8/SPKI PEM values encoded as base64. See docs/authentication.md for rotation.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_KEY_ID=focused-local-1
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=focused-api
# 32 random bytes encoded as base64; used for short-lived OAuth transaction secrets.
AUTH_DATA_ENCRYPTION_KEY_BASE64=

# Distributed Authentication rate limiting. Mandatory in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth is enabled only when both values are configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI providers are server-only. Never prefix these with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Set true only after Zero Data Retention is enabled in Groq Data Controls.
GROQ_ZERO_DATA_RETENTION=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Unpaid Gemini is blocked from personal Focused context by policy.
GEMINI_SERVICE_TIER=unpaid

# Web Push. Generate one VAPID key pair and keep the private key server-only.
VAPID_SUBJECT=mailto:notifications@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# QStash signs the internal notification worker and provides durable retries.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
