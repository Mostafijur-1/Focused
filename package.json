{
  "name": "focused",
  "version": "0.1.0",
  "private": true,
  "description": "Focused — a Bangla-first Focus Operating System.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:drift:check": "node scripts/verify-schema-drift.mjs",
    "dev": "corepack pnpm --filter @focused/web dev",
    "build": "corepack pnpm --filter @focused/web build",
    "start": "corepack pnpm --filter @focused/web start",
    "lint": "corepack pnpm --filter @focused/web lint",
    "lint:fix": "corepack pnpm --filter @focused/web lint:fix",
    "typecheck": "corepack pnpm --filter @focused/web typecheck",
    "test": "corepack pnpm --filter @focused/web test",
    "test:coverage": "corepack pnpm --filter @focused/web test:coverage",
    "test:e2e": "corepack pnpm --filter @focused/web test:e2e",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "api:lint": "redocly lint api/openapi.yaml",
    "quality": "corepack pnpm db:validate && corepack pnpm format && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test:coverage && corepack pnpm api:lint && corepack pnpm build"
  },
  "devDependencies": {
    "@redocly/cli": "2.43.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.9.1"
  }
}
